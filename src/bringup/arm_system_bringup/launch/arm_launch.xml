<launch>
    <!-- Environment Variables Configuration
        - GZ_SIM_RESOURCE_PATH: Sets paths where Gazebo should look for simulation resources
        - GAZEBO_MODEL_PATH: Sets paths where Gazebo should look for robot models-->
    <set_env name="GZ_SIM_RESOURCE_PATH"
        value="$(find-pkg-prefix arm_description)/share:/opt/ros/jazzy/share" />

    <set_env name="GAZEBO_MODEL_PATH"
        value="$(find-pkg-prefix arm_description)/share" />

    <!-- Path Configuration Variables
        - urdf_path: Path to the robot URDF/XACRO file
        - rviz_config_path: Path to RViz configuration file
        - arm_gazebo_bridge_config_path: Path to Gazebo-ROS bridge configuration
        - controllers_config_path: Path to ROS 2 controllers configuration -->
    <let name="urdf_path"
        value="$(find-pkg-share arm_description)/urdf/arm.urdf.xacro" />

    <let name="arm_gazebo_bridge_config_path"
        value="$(find-pkg-share arm_system_bringup)/config/gazebo_bridge.yaml" />

    <let name="controllers_config_path"
        value="$(find-pkg-share arm_gazebo)/config/controllers.yaml" />

    <!-- Robot State Publisher
        - Reads the robot description from URDF/XACRO
        - Publishes robot state and TF transforms
        - Required for RViz visualization and coordinate transformations -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
            value="$(command 'xacro $(var urdf_path)  use_sim:=true')" />
        <param name="use_sim_time" value="true" />
    </node>

    <!-- Gazebo Simulation
        - Starts the Gazebo simulation environment
        - Uses an empty world (empty.sdf)
        - -r flag: runs simulation immediately-->
    <arg name="world_sdf_file" default="empty.sdf" />
    <arg name="world_sdf_string" default="" />
    <arg name="container_name" default="ros_gz_container" />
    <arg name="create_own_container" default="False" />
    <arg name="use_composition" default="False" />
    <gz_server
        world_sdf_file="$(var world_sdf_file)"
        world_sdf_string="$(var world_sdf_string)"
        container_name="$(var container_name)"
        create_own_container="$(var create_own_container)"
        use_composition="$(var use_composition)">
    </gz_server>

    <!--  Spawn Robot in Gazebo
        - Creates the robot model in Gazebo simulation
        - Uses the robot_description from the parameter server
        - The robot appears in the simulation world -->
    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description" />

    <!--  ROS-Gazebo Bridge
        - Bridges communication between ROS 2 and Gazebo
        - Uses configuration file to define which topics to bridge
        - Enables data exchange between simulation and ROS ecosystem-->
    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file"
            value="$(var arm_gazebo_bridge_config_path)" />
    </node>

    <!-- Controller Initialization with Timer
        - Waits 5 seconds for Gazebo to fully initialize before loading controllers
        - Prevents race conditions where controllers start before simulation is ready-->
    <timer period="5.0">
        <!-- Joint State Broadcaster
            - Publishes current joint states to /joint_states topic
            - Required for monitoring robot state in ROS 2 -->
        <node pkg="controller_manager" exec="spawner" name="joint_state_broadcaster_spawner"
            args="joint_state_broadcaster -c /controller_manager" />

        <!--  Arm Controller
            - Main trajectory controller for the robotic arm
            - Handles joint trajectory commands for motion planning
            - Interfaces with Gazebo through the control plugin-->
        <node pkg="controller_manager" exec="spawner" name="arm_controller_spawner"
            args="arm_controller -c /controller_manager" />
    </timer>

</launch>