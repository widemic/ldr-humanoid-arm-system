<?xml version="1.0"?>
<xacro:macro xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:property name="damping" value="0.05" />
    <xacro:property name="friction" value="0.01" />

    <gazebo reference="left_shoulder_pitch_rs04">
        <damping>${damping}</damping>
        <friction>${friction}</friction>
    </gazebo>

    <gazebo reference="left_shoulder_roll_rs04">
        <damping>${damping}</damping>
        <friction>${friction}</friction>
    </gazebo>

    <gazebo reference="left_shoulder_yaw_rs03">
        <damping>${damping}</damping>
        <friction>${friction}</friction>
    </gazebo>

    <gazebo reference="left_elbow_rs03">
        <damping>${damping}</damping>
        <friction>${friction}</friction>
    </gazebo>

    <gazebo reference="left_wrist_rs02">
        <damping>${damping}</damping>
        <friction>${friction}</friction>
    </gazebo>

    <gazebo reference="left_hand_rs02">
        <damping>${damping}</damping>
        <friction>${friction}</friction>
    </gazebo>

    <gazebo reference="left_palm_right_finger_joint">
        <damping>${damping}</damping>
        <friction>${friction}</friction>
    </gazebo>

    <gazebo reference="left_palm_left_finger_joint">
        <damping>${damping}</damping>
        <friction>${friction}</friction>
    </gazebo>
    
</xacro:macro>