<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Base link (table/stand with menghina and stator) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.15231 0.00126822 -0.0733771" rpy="0 0 0"/>
      <mass value="12.7824"/>
      <inertia ixx="0.319682" ixy="2.7236e-08" ixz="0.0107613" iyy="0.0695316" iyz="1.98209e-07" izz="0.343485"/>
    </inertial>
    <!-- Table -->
    <visual>
      <origin xyz="0.171858 0.00126819 -0.0923205" rpy="-3.14159 2.84025e-16 -1.25251e-16"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/visual/table.stl"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.171858 0.00126819 -0.0923205" rpy="-3.14159 2.84025e-16 -1.25251e-16"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/visual/table.stl"/>
      </geometry>
    </collision>
    <!-- Table legs (2 legs) -->
    <visual>
      <origin xyz="0.08 0.17 -0.49" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.75"/>
      </geometry>
      <material name="dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0.08 0.17 -0.49" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.75"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0.08 -0.17 -0.49" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.75"/>
      </geometry>
      <material name="dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0.08 -0.17 -0.49" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.75"/>
      </geometry>
    </collision>
    <!-- Menghina mount (on table surface) -->
    <visual>
      <origin xyz="0.0868579 0.00126819 6.80296e-06" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/visual/menghina_x6.stl"/>
      </geometry>
      <material name="dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0.0868579 0.00126819 6.80296e-06" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/visual/menghina_x6.stl"/>
      </geometry>
    </collision>
    <!-- Spacer between menghina and stator -->
    <visual>
      <origin xyz="0.00685786 0.00126819 6.80296e-06" rpy="1.5708 -1.5708 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/visual/spacer_x6_menghina_m4x60.stl"/>
      </geometry>
      <material name="purple"/>
    </visual>
    <collision>
      <origin xyz="0.00685786 0.00126819 6.80296e-06" rpy="1.5708 -1.5708 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/visual/spacer_x6_menghina_m4x60.stl"/>
      </geometry>
    </collision>
    <!-- Rotor X6 (base) -->
    <visual>
      <origin xyz="0.141358 0.00126819 6.80296e-06" rpy="0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/visual/rotor_x6_p20_60.stl"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.141358 0.00126819 6.80296e-06" rpy="0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/visual/rotor_x6_p20_60.stl"/>
      </geometry>
    </collision>
    <!-- Stator X6 (on table surface) -->
    <visual>
      <origin xyz="0.141358 0.00126819 6.80296e-06" rpy="0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/visual/stator_x6_p20_60.stl"/>
      </geometry>
      <material name="gold"/>
    </visual>
    <collision>
      <origin xyz="0.141358 0.00126819 6.80296e-06" rpy="0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/visual/stator_x6_p20_60.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Link 1: Shoulder (pitch rotation) -->
