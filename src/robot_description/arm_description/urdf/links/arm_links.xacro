      <geometry>
        <mesh filename="package://arm_description/meshes/visual/l_shoulder.stl"/>
      </geometry>
    </collision>
    <!-- Stator X6 for next joint -->
    <visual>
      <origin xyz="-0.0385 0 -0.078" rpy="-3.14159 -1.5708 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/visual/stator_x6_p20_60.stl"/>
      </geometry>
      <material name="gold"/>
    </visual>
    <collision>
      <origin xyz="-0.0385 0 -0.078" rpy="-3.14159 -1.5708 0"/>
