        <parent link="left_elbow" />
        <child link="left_wrist_actuator" />
        <axis xyz="0 0 0" />
    </joint>
    <joint name="left_wrist_rs02" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="left_wrist_actuator" />
        <child link="left_wrist_rs02_flange" />
        <axis xyz="0 1 0" />
        <limit lower="-3.14" upper="3.14" effort="6.0" velocity="37.70" />
        <safety_controller soft_upper_limit="3.14" soft_lower_limit="-3.14" k_velocity="0" />
        <dynamics damping="0.25" friction="0.8" />
    </joint>
    <joint name="left_wrist_fixture" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="left_wrist_rs02_flange" />
        <child link="left_wrist" />
        <axis xyz="0 0 0" />
    </joint>
    <joint name="left_hand_rs02_fixture_link" type="fixed">
        <origin xyz="0 0.0945 0" rpy="0 0.44406 0" />
        <parent link="left_wrist" />
        <child link="left_hand_rs02_actuator" />
        <axis xyz="0 0 0" />
    </joint>
    <joint name="left_hand_rs02" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="left_hand_rs02_actuator" />
        <child link="left_hand_rs02_flange" />
        <axis xyz="1 0 0" />
        <limit lower="-1.5" upper="1.7" effort="6.0" velocity="37.70" />
        <safety_controller soft_upper_limit="1.7" soft_lower_limit="-1.5" k_velocity="0" />
        <dynamics damping="0.25" friction="0.8" />
    </joint>
    <joint name="left_hand_fixture" type="fixed">
        <origin xyz="0 0 0" rpy="0.785 0 0" />
        <parent link="left_hand_rs02_flange" />
        <child link="left_hand" />
        <axis xyz="0 0 0" />
    </joint>
    <joint name="left_palm_fixture" type="fixed">
        <origin xyz="0 0.046829 -0.045845" rpy="-0.77494 -0.017568 0.017203" />
        <parent link="left_hand" />
        <child link="left_palm" />
        <axis xyz="0 0 0" />
    </joint>
    <!-- Gripper finger joints: Right finger (independent control) -->
    <joint name="left_palm_right_finger" type="prismatic">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="left_palm" />
        <child link="left_palm_right_finger_link" />
        <axis xyz="-1 0 0" />
        <limit lower="-0.04" upper="0.0" effort="10" velocity="0.05" />
        <safety_controller soft_upper_limit="0.0" soft_lower_limit="-0.04" k_velocity="0" />
        <dynamics damping="0.1" friction="0.1" />
    </joint>
 
    <!-- Left finger mimics right finger (symmetric movement) -->
    <joint name="left_palm_left_finger" type="prismatic">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="left_palm" />
        <child link="left_palm_left_finger_link" />
        <axis xyz="-1 0 0" />
        <limit lower="0.0" upper="0.04" effort="10" velocity="0.05" />
        <safety_controller soft_upper_limit="0.04" soft_lower_limit="0.0" k_velocity="0" />
        <mimic joint="left_palm_right_finger" multiplier="-1.0" offset="0" />
        <dynamics damping="0.1" friction="1.0" />
    </joint>
 

</robot>