        <axis xyz="0 0 0" />
    </joint>
    <joint name="left_elbow_rs03_actuator_ficture_link" type="fixed">
        <origin xyz="0 0 -0.0987" rpy="0 0 0" />
        <parent link="left_shoulder_yaw" />
        <child link="left_elbow_rs03_actuator" />
        <axis xyz="0 0 0" />
    </joint>
    <joint name="left_elbow_rs03" type="revolute">
