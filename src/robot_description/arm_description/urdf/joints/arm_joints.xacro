<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <joint name="left_shoulder_pitch_rs04_actuator_fixture_link" type="fixed">
        <origin xyz="-0.1079 0 1.425" rpy="0 0 3.1416" />
