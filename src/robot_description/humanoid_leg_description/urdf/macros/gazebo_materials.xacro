<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Gazebo material definitions for KBOT humanoid robot -->
  <!-- These are required for visualization in Gazebo and RViz -->

  <xacro:macro name="gazebo_materials" params="prefix">

    <!-- Base Link -->
    <gazebo reference="${prefix}base_link">
      <material>Gazebo/Red</material>
    </gazebo>

    <!-- Torso Link -->
    <gazebo reference="${prefix}torso_link">
      <material>Gazebo/Blue</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>

    <!-- IMU Link -->
    <gazebo reference="${prefix}imu_link">
      <material>Gazebo/Grey</material>
    </gazebo>

    <!-- Left Leg Materials -->
    <gazebo reference="${prefix}left_hip_yoke_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>

    <gazebo reference="${prefix}left_hip_roll_link">
      <material>Gazebo/Blue</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>

    <gazebo reference="${prefix}left_hip_pitch_link">
      <material>Gazebo/Blue</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>

    <gazebo reference="${prefix}left_femur_link">
      <material>Gazebo/Grey</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>

    <gazebo reference="${prefix}left_shin_link">
      <material>Gazebo/Blue</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>

    <gazebo reference="${prefix}left_foot_link">
      <material>Gazebo/Orange</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e7</kp>
      <kd>1.0</kd>
    </gazebo>

    <!-- Right Leg Materials -->
    <gazebo reference="${prefix}right_hip_yoke_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>

    <gazebo reference="${prefix}right_hip_roll_link">
      <material>Gazebo/Blue</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>

    <gazebo reference="${prefix}right_hip_pitch_link">
      <material>Gazebo/Blue</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>

    <gazebo reference="${prefix}right_femur_link">
      <material>Gazebo/Grey</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>

    <gazebo reference="${prefix}right_shin_link">
      <material>Gazebo/Blue</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>

    <gazebo reference="${prefix}right_foot_link">
      <material>Gazebo/Orange</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e7</kp>
      <kd>1.0</kd>
    </gazebo>

  </xacro:macro>

</robot>
