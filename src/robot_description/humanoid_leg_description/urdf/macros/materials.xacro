<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Material definitions for KBOT humanoid robot -->

  <xacro:macro name="materials">

    <!-- Blue - Primary structural color -->
    <material name="blue">
      <color rgba="0.615686 0.811765 0.929412 1"/>
    </material>

    <!-- Dark Gray - Hip yoke actuators -->
    <material name="dark_gray">
      <color rgba="0.262745 0.282353 0.301961 1"/>
    </material>

    <!-- Orange - Feet -->
    <material name="orange">
      <color rgba="0.972549 0.529412 0.003922 1"/>
    </material>

    <!-- Medium Gray - Femur links -->
    <material name="medium_gray">
      <color rgba="0.439216 0.474510 0.501961 1"/>
    </material>

    <!-- Red - Base link visualization -->
    <material name="red">
      <color rgba="1 0 0 1"/>
    </material>

    <!-- Gray - Generic gray for other components -->
    <material name="gray">
      <color rgba="0.5 0.5 0.5 1"/>
    </material>

    <!-- Black - For specific components -->
    <material name="black">
      <color rgba="0.1 0.1 0.1 1"/>
    </material>

  </xacro:macro>

</robot>
