<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="leg_links" params="prefix">

    <!-- LEFT LEG LINKS -->

    <!-- Left Hip Yoke Link -->
        <link name="${prefix}left_hip_yoke_link">
      <inertial>
        <origin xyz="0.035933 0.047017 0.000007" rpy="0 0 0"/>
        <mass value="0.649617"/>
        <inertia ixx="0.000543" ixy="0.000296" ixz="0.0" iyy="0.000415" iyz="0.0" izz="0.000773"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://humanoid_leg_description/meshes/KB_D_102L_L_HIP_YOKE.stl" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="">
          <color rgba="0.262745 0.282353 0.301961 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
