<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kbot_humanoid">

  <!-- Arguments -->
  <xacro:arg name="use_sim" default="true" />
  <xacro:arg name="prefix" default="" />

  <!-- Include appropriate xacro based on use_sim argument -->
  <xacro:if value="$(arg use_sim)">
    <xacro:include filename="$(find humanoid_leg_description)/urdf/robot_gazebo.xacro" />
  </xacro:if>

  <xacro:unless value="$(arg use_sim)">
    <xacro:include filename="$(find humanoid_leg_description)/urdf/robot_real.xacro" />
  </xacro:unless>

</robot>
